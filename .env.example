# Docker Compose defaults. Copy to .env for container-based local development or deployment.
# For direct `go run ./cmd/server` on the host, use a separate .env with local paths such as data/uploads.

APP_ENV=development
TZ=Asia/Shanghai

BACKEND_PORT=8000
FRONTEND_PORT=5173
MYSQL_PORT=3306

MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=novel_reader
MYSQL_USER=novel_reader
MYSQL_PASSWORD=change-me-db-password
DATABASE_DSN=novel_reader:change-me-db-password@tcp(mysql:3306)/novel_reader?charset=utf8mb4&parseTime=True&loc=Local

UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_BYTES=52428800

# Covers (jpg/png/webp, <= 10MB)
COVER_DIR=/app/data/uploads/covers
MAX_COVER_BYTES=10485760

# Avatars (jpg/jpeg/png/webp, <= 5MB)
AVATAR_DIR=/app/data/uploads/avatars
MAX_AVATAR_BYTES=5242880

# Optional: custom placeholder cover returned by GET /api/books/{id}/cover when no cover uploaded.
# Can be an absolute path, or a path relative to COVER_DIR (recommended).
DEFAULT_COVER_FILE=

JWT_SECRET=change-me-jwt-secret

SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=change-me-admin-password

VITE_API_BASE_URL=http://localhost:8000
