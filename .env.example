# Local development defaults. Copy to .env and change secrets for shared or production-like use.

APP_ENV=development
TZ=Asia/Shanghai

BACKEND_PORT=8000
FRONTEND_PORT=5173
MYSQL_PORT=3306

MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=novel_reader
MYSQL_USER=novel_reader
MYSQL_PASSWORD=change-me-db-password
DATABASE_DSN=novel_reader:change-me-db-password@tcp(mysql:3306)/novel_reader?charset=utf8mb4&parseTime=True&loc=Local

UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_BYTES=52428800
JWT_SECRET=change-me-jwt-secret

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

VITE_API_BASE_URL=http://localhost:8000
